# Inputs and device constants for the Xiaomi Mi 9 (cepheus) ColorOS 17 port. Sourced by port.sh.

# Hardware layer: Project Infinity-X 4.2 for cepheus (Android 17, 4.14.357 kernel with eBPF backports,
# retrofit dynamic partitions). Provides boot (kernel + ramdisk), dtbo, vbmeta, vendor and odm.
BASE_URL="https://sourceforge.net/projects/device-xiaomi-cepheus/files/Infinity-X/17/vanilla/Project_Infinity-X-4.2-cepheus-09.11.2026-VANILLA-UNOFFICIAL.zip/download"
BASE_SIZE=1836761537
BASE_SHA256=37a52d34836f070cc9b06d72c857f5f557c2f8ec5f23848d90a86bf827e9dfc1

# System layer: ColorOS 17 for the OnePlus 15 (PLK110, Qualcomm system image) as packaged by the Axis GSI
# project: one ext4 system.img holding system, system_ext, product and the my_* trees.
DONOR_URL="https://sourceforge.net/projects/axisgsiupdates/files/coloros/ColorOS-17-PLK110-1789230075256-18092026-AxisGSI.zip/download"
DONOR_SIZE=3369547979
DONOR_MD5=103e36d468a3304def0c0030c5870d8e      # as published in the project's SourceForge file feed

# Retrofit super partition of the base ROM: metadata on "system", spanning three physical partitions.
SUPER_NAME=system
SUPER_DEVICES="system:3758096384 vendor:1610612736 cust:1073741824"
SUPER_GROUP=qti_dynamic_partitions
SUPER_GROUP_SIZE=6438256640
SUPER_METADATA_SIZE=65536
SUPER_METADATA_SLOTS=2

# Build options (override in the environment).
: "${FBE_MODE:=standard}"            # standard = plain AOSP FBE; keep = the base ROM's wrapped-key setup
: "${IMS:=base}"                    # base = the base ROM's IMS app, patched (VoLTE); donor = ColorOS's own
: "${SOUNDTRIGGER:=remove}"          # remove = drop the SoundTrigger HIDL service; keep = leave the vendor's
: "${BOOTLOG:=1}"                    # 1 = keep boot logs on the cache partition (experimental builds)
: "${EROFS_COMPRESS:=lz4hc,9}"       # the base kernel's EROFS reads LZ4 only
# Timestamp of every file in the system and vendor images. The build time is used so that, after re-flashing
# a newer build over existing data, files are newer than the package manager's cache and get re-read.
: "${FIXED_TIME:=$(date +%s)}"
