<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces the donor's OnePlus 15 rounded-corner and camera-hole masks. The Mi 9 panel is physically rounded
     and has no punch hole, so every mask is fully transparent (generated by tools/build_overlays.sh). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="oplus.frameworkres.overlay.display.product"
    android:versionCode="33"
    android:versionName="33">
    <application android:allowBackup="false" android:extractNativeLibs="false" android:hasCode="false" />
    <overlay android:priority="700" android:targetPackage="oplus" android:isStatic="true" />
</manifest>
